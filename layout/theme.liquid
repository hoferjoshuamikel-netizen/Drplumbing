<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.brand_navy }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} — {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} — Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    <style>
      :root {
        --navy: {{ settings.brand_navy }};
        --red: {{ settings.brand_red }};
        --cream: {{ settings.brand_cream }};
        --ink: {{ settings.text_color }};
        --muted: {{ settings.muted_color }};
        --border: #d9dee8;
        --white: #ffffff;
        --shadow: 0 12px 36px rgba(20, 35, 75, 0.12);
        --radius: {{ settings.card_radius }}px;
        --page: {{ settings.page_width }}px;
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <div class="mobile-action-bar" aria-label="Quick contact actions">
      <a class="mobile-action mobile-action--call" href="tel:{{ settings.phone_digits | escape }}">Call</a>
      <a class="mobile-action mobile-action--text" href="sms:{{ settings.phone_digits | escape }}">Text</a>
      <a class="mobile-action mobile-action--quote" href="{{ settings.quote_url | default: '/pages/request-service' }}">Free quote</a>
    </div>
  </body>
</html>
