<section class="section {% if section.settings.background == 'cream' %}section--cream{% elsif section.settings.background == 'navy' %}section--navy{% endif %}">
  <div class="page-width">
    {% if section.settings.kicker != blank %}<p class="section-kicker">{{ section.settings.kicker }}</p>{% endif %}
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<div class="section-copy rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <p><a class="button {% if section.settings.background == 'navy' %}button--light{% endif %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A straightforward local company" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use this section to explain the company’s story, service philosophy or customer promise.</p>" },
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" },
      { "value": "cream", "label": "Light" },
      { "value": "navy", "label": "Navy" }
    ] },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
