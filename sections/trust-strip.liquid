<section class="trust-strip" aria-label="Why choose DR Plumbing">
  <div class="page-width trust-grid">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.heading }}</strong>
        <span>{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Call or text" },
        { "type": "text", "id": "text", "label": "Text", "default": "Fast, simple communication" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "item", "settings": { "heading": "Family-owned", "text": "Local people, personal service" } },
        { "type": "item", "settings": { "heading": "Call or text", "text": "585-465-2138" } },
        { "type": "item", "settings": { "heading": "Emergency help", "text": "Nights, weekends and holidays" } },
        { "type": "item", "settings": { "heading": "Free quotes", "text": "Tell us what is going on" } }
      ]
    }
  ]
}
{% endschema %}
