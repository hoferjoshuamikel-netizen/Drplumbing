<section class="section {% if section.settings.background == 'cream' %}section--cream{% endif %}">
  <div class="page-width">
    <div class="heading-row">
      <div>
        {% if section.settings.kicker != blank %}<p class="section-kicker">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.copy != blank %}<div class="section-copy rte">{{ section.settings.copy }}</div>{% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a class="button button--navy" href="{{ section.settings.button_link | default: '/pages/services' }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="service-grid">
      {% for block in section.blocks %}
        <article class="service-card" {{ block.shopify_attributes }}>
          <span class="service-card__number">{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.link != blank %}<p><a class="text-link" href="{{ block.settings.link }}">Learn more</a></p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Service grid",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Complete plumbing help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The services homeowners need most" },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Clear service categories help customers quickly identify the problem and contact the right local team.</p>" },
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" },
      { "value": "cream", "label": "Light" }
    ] },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all services" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Drain cleaning and snaking" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Help for slow, clogged and backed-up drains." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service grid",
      "blocks": [
        { "type": "service", "settings": { "heading": "Drain cleaning and snaking", "text": "Help for slow, clogged and backed-up drains." } },
        { "type": "service", "settings": { "heading": "Bathrooms and kitchens", "text": "Fixtures, leaks, repairs and plumbing improvements." } },
        { "type": "service", "settings": { "heading": "Sump pumps", "text": "Installation, replacement and troubleshooting." } },
        { "type": "service", "settings": { "heading": "Sewer services", "text": "Assessment and service for troublesome sewer lines." } },
        { "type": "service", "settings": { "heading": "Winterizations", "text": "Prepare plumbing systems and properties for freezing weather." } },
        { "type": "service", "settings": { "heading": "Emergency plumbing", "text": "Call or text for urgent plumbing problems, including nights, weekends and holidays." } }
      ]
    }
  ]
}
{% endschema %}
