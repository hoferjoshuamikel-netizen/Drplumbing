<section class="section {% if section.settings.background == 'cream' %}section--cream{% endif %}" id="request-service">
  <div class="page-width">
    <div class="form-card">
      {% if section.settings.kicker != blank %}<p class="section-kicker">{{ section.settings.kicker }}</p>{% endif %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {% if section.settings.copy != blank %}<div class="section-copy rte">{{ section.settings.copy }}</div>{% endif %}

      {% form 'contact', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <p class="form-success" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>
        {% endif %}
        {% if form.errors %}
          <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="form-grid">
          <div class="field">
            <label for="ContactName-{{ section.id }}">Name</label>
            <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>
          <div class="field">
            <label for="ContactPhone-{{ section.id }}">Phone</label>
            <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" required value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
          </div>
          <div class="field">
            <label for="ContactEmail-{{ section.id }}">Email</label>
            <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
          </div>
          <div class="field">
            <label for="ContactPreference-{{ section.id }}">Preferred response</label>
            <select id="ContactPreference-{{ section.id }}" name="contact[Preferred response]">
              <option>Call me</option>
              <option>Text me</option>
              <option>Email me</option>
            </select>
          </div>
          <div class="field">
            <label for="ContactZip-{{ section.id }}">Service address or ZIP code</label>
            <input id="ContactZip-{{ section.id }}" type="text" name="contact[Service address or ZIP]" autocomplete="postal-code">
          </div>
          <div class="field">
            <label for="ContactUrgency-{{ section.id }}">Urgency</label>
            <select id="ContactUrgency-{{ section.id }}" name="contact[Urgency]">
              <option>Regular appointment</option>
              <option>Urgent</option>
              <option>Emergency</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="ContactService-{{ section.id }}">Type of plumbing help</label>
            <select id="ContactService-{{ section.id }}" name="contact[Service needed]">
              <option>Drain cleaning or snaking</option>
              <option>Bathroom plumbing</option>
              <option>Kitchen plumbing</option>
              <option>Sump pump</option>
              <option>Sewer service</option>
              <option>Winterization</option>
              <option>Leak or fixture repair</option>
              <option>Other plumbing problem</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="ContactMessage-{{ section.id }}">Tell us what is happening</label>
            <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea>
          </div>
          <div class="field field--full">
            <button class="button" type="submit">{{ section.settings.button_label }}</button>
          </div>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Request service form",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Free quote request" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us what is going on" },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>For emergencies, call or text 585-465-2138. For regular service, send the details below and the plumbing team can follow up.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request my free quote" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you. Your request was sent to DR Plumbing." },
    { "type": "select", "id": "background", "label": "Background", "default": "cream", "options": [
      { "value": "white", "label": "White" },
      { "value": "cream", "label": "Light" }
    ] }
  ],
  "presets": [{ "name": "Request service form" }]
}
{% endschema %}
