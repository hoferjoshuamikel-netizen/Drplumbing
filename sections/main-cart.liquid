<header class="page-hero">
  <div class="page-width"><h1>Your cart</h1></div>
</header>

<section class="section">
  <div class="page-width">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th></tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td>
                  <div class="cart-item">
                    {% if item.image %}
                      {% assign cart_image_alt = item.image.alt | default: item.product.title %}
                      {{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: cart_image_alt }}
                    {% endif %}
                    <div>
                      <a class="text-link" href="{{ item.url }}">{{ item.product.title }}</a>
                      {% unless item.product.has_only_default_variant %}<div>{{ item.variant.title }}</div>{% endunless %}
                      <a href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                </td>
                <td>{{ item.final_price | money }}</td>
                <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title }}"></td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="cart-summary">
          <div class="cart-summary__box">
            <div class="cart-summary__row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
            <p>Shipping and taxes are calculated at checkout.</p>
            <button class="button button--outline" type="submit" name="update">Update cart</button>
            <button class="button" type="submit" name="checkout">Checkout</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="empty-state">
        <h2>Your cart is empty</h2>
        <p>Browse DR Plumbing apparel, hats, magnets, mugs, phone cases and more.</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">Shop merchandise</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
