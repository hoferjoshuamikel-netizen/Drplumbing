[
  {
    "name": "theme_info",
    "theme_name": "DR Plumbing Service & Shop",
    "theme_author": "DR Plumbing",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://help.shopify.com/en/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Use the approved DR Plumbing logo. It is always displayed on white in this theme."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "color",
        "id": "brand_navy",
        "label": "Navy",
        "default": "#172650"
      },
      {
        "type": "color",
        "id": "brand_red",
        "label": "Red",
        "default": "#D62828"
      },
      {
        "type": "color",
        "id": "brand_cream",
        "label": "Light background",
        "default": "#F7F5F0"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "default": "#17213A"
      },
      {
        "type": "color",
        "id": "muted_color",
        "label": "Muted text",
        "default": "#5A6477"
      }
    ]
  },
  {
    "name": "Business information",
    "settings": [
      {
        "type": "text",
        "id": "phone_display",
        "label": "Displayed phone number",
        "default": "585-465-2138"
      },
      {
        "type": "text",
        "id": "phone_digits",
        "label": "Phone link",
        "default": "+15854652138",
        "info": "Include country code and digits only, for example +15854652138."
      },
      {
        "type": "text",
        "id": "availability",
        "label": "Availability message",
        "default": "Emergency service • Nights • Weekends • Holidays"
      },
      {
        "type": "url",
        "id": "quote_url",
        "label": "Request-service page"
      },
      {
        "type": "text",
        "id": "service_area",
        "label": "Service area",
        "default": "Proudly serving our local community"
      },
      {
        "type": "text",
        "id": "email",
        "label": "Customer email"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1240
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 28,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 14
      }
    ]
  }
]
